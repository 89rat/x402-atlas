{
  "name": "x402-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply x402-atlas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply x402-atlas-db --remote",
    "crawl": "wrangler dev --test-scheduled | true"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
